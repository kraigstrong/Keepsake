{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["jest"],
    // server/units/*.ts files import each other with explicit .ts
    // extensions (Deno, which bundles the import-recipe Edge Function,
    // requires it on every local relative import — unlike every other
    // server/ module so far, this is the first one where files import
    // each other rather than being self-contained). Safe here since the
    // base config already sets noEmit: true.
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "eslint.config.js",
    "android",
    "ios",
    // Deno Edge Functions (Phase 8+, ADR-0015) are a separate runtime and
    // type universe (Deno globals, npm:/jsr: specifiers, .ts-extension
    // imports) — not checkable by this Node/RN project's tsc. Verified
    // instead by `supabase functions deploy` (which bundles and type-
    // checks via Deno itself) and a real invocation against staging.
    "supabase/functions"
  ]
}
