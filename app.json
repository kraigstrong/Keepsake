{
  "expo": {
    "name": "Keepsake",
    "slug": "keepsake",
    "scheme": "keepsake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kraigstrong.keepsake",
      "buildNumber": "4",
      "supportsTablet": false,
      "appleTeamId": "MKACSCQ588",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.kraigstrong.keepsake"]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Keepsake needs photo access to import a recipe photo.",
          "cameraPermission": "Keepsake needs camera access to photograph a recipe.",
          "microphonePermission": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": false,
          "remindersPermission": "Keepsake needs Reminders access to export your grocery list."
        }
      ],
      "@bacons/apple-targets",
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ]
  }
}
