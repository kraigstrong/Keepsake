# This file documents which environment variables exist — it holds no real values.
# Real values are injected at run/build time via 1Password CLI (`op run --env-file=.env.example -- <command>`)
# or 1Password Environments in CI. Never fill this file in and commit it; never hand-copy real
# values into a local .env — if a local .env is unavoidable, generate it from 1Password and keep
# it out of Git (already covered by .gitignore).

# Supabase (client-safe — anon key, not service role)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-side only — Edge Functions / server context, never bundled into the client)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-side only, never bundled into the client)
ANTHROPIC_API_KEY=

# Add new variables here as Phase 0 and later phases introduce them, with a comment noting
# whether each is client-safe or server-only.
